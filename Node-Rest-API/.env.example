# Local development reads Node-Rest-API/.env and the repo-root .env.local.
# The easiest setup is `neon env pull` in the repo root, which writes all of
# these into .env.local for you.

# Neon Postgres: pooled URL for the app, direct URL for migrations.
DATABASE_URL=postgresql://<user>:<password>@<endpoint>-pooler.<region>.aws.neon.tech/neondb?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://<user>:<password>@<endpoint>.<region>.aws.neon.tech/neondb?sslmode=require

# Neon object storage (S3-compatible). Leave these out to store uploads on local disk.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=
AWS_REGION=us-east-2

# Only needed for the one-off MongoDB → Postgres migration (npm run migrate:mongo).
MONGO_URL=
