{
  "name": "rest-api",
  "version": "1.0.0",
  "description": "",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "npm run build && node dist/index.js",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "test": "jest --runInBand",
    "db:generate": "drizzle-kit generate",
    "migrate:mongo": "npm run build && node dist/scripts/migrateFromMongo.js",
    "seed:demo": "npm run build && node dist/scripts/seedDemo.js",
    "admin": "npm run build && node dist/scripts/admin.js"
  },
  "jest": {
    "testEnvironment": "node",
    "transform": {
      "^.+\\.ts$": [
        "ts-jest",
        {
          "tsconfig": "tsconfig.test.json"
        }
      ]
    },
    "testMatch": [
      "<rootDir>/tests/**/*.test.ts"
    ],
    "globalSetup": "<rootDir>/tests/globalSetup.ts",
    "globalTeardown": "<rootDir>/tests/globalTeardown.ts",
    "setupFilesAfterEnv": [
      "<rootDir>/tests/setup.ts"
    ],
    "testTimeout": 30000
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1165.0",
    "@aws-sdk/s3-request-presigner": "^3.1165.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^8.2.0",
    "drizzle-orm": "^0.45.4",
    "express": "^4.22.3",
    "express-rate-limit": "^7.5.1",
    "helmet": "^8.3.0",
    "morgan": "^1.12.1",
    "multer": "^2.5.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^4.17.25",
    "@types/jest": "^29.5.14",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^1.4.13",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^6.0.3",
    "drizzle-kit": "^0.31.11",
    "embedded-postgres": "^17.5.0-beta.15",
    "jest": "^29.7.0",
    "mongoose": "^8.24.9",
    "nodemon": "^3.1.14",
    "supertest": "^6.3.4",
    "ts-jest": "^29.4.15",
    "typescript": "5.9"
  },
  "engines": {
    "node": ">=20 <23"
  }
}
